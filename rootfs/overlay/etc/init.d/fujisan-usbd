#!/sbin/openrc-run
# Fujisan OS — DWC3 USB 3.1 Composite Gadget Service (NCM / UVC / MTP)
# Hardware: Synopsys DWC3 @ 0xFFB0C100 (USB3 PHY 0xFFB23800)

name="fujisan-usbd"
description="Configure Fujisan OS DWC3 USB composite gadget (NCM/UVC/MTP)"

: "${FUJISAN_USB_PROFILE:=ncm}"
: "${FUJISAN_USB_IP:=172.16.42.1/24}"
: "${FUJISAN_USB_VID:=0x04cb}"
: "${FUJISAN_USB_PID:=0x02f0}"

GADGET_DIR="/sys/kernel/config/usb_gadget/fujisan"

depend() {
    need localmount
    after udev
}

start() {
    ebegin "Starting ${name} (profile=${FUJISAN_USB_PROFILE})"
    if [ ! -d /sys/kernel/config ]; then
        mount -t configfs none /sys/kernel/config 2>/dev/null || true
    fi
    if [ ! -d /sys/kernel/config/usb_gadget ]; then
        ewarn "USB gadget configfs unavailable; skipping UDC bind"
        eend 0
        return 0
    fi

    udc="$(ls /sys/class/udc 2>/dev/null | head -n 1 || true)"
    if [ -z "$udc" ]; then
        ewarn "No DWC3 UDC device present; running in offline USB standby"
        eend 0
        return 0
    fi

    mkdir -p "${GADGET_DIR}/strings/0x409" "${GADGET_DIR}/configs/c.1/strings/0x409"
    echo "${FUJISAN_USB_VID}" > "${GADGET_DIR}/idVendor"
    echo "${FUJISAN_USB_PID}" > "${GADGET_DIR}/idProduct"
    echo "0x0200" > "${GADGET_DIR}/bcdUSB"
    echo "Fujisan OS" > "${GADGET_DIR}/strings/0x409/manufacturer"
    echo "SPX4-MF Fujisan Gadget" > "${GADGET_DIR}/strings/0x409/product"
    echo "SPX4-FUJISAN-01" > "${GADGET_DIR}/strings/0x409/serialnumber"
    echo "Fujisan Composite (${FUJISAN_USB_PROFILE})" > "${GADGET_DIR}/configs/c.1/strings/0x409/configuration"

    case "${FUJISAN_USB_PROFILE}" in
        *ncm*)
            mkdir -p "${GADGET_DIR}/functions/ncm.usb0"
            ln -sf "${GADGET_DIR}/functions/ncm.usb0" "${GADGET_DIR}/configs/c.1/"
            ;;
    esac
    case "${FUJISAN_USB_PROFILE}" in
        *uvc*)
            mkdir -p "${GADGET_DIR}/functions/uvc.usb0"
            ln -sf "${GADGET_DIR}/functions/uvc.usb0" "${GADGET_DIR}/configs/c.1/"
            ;;
    esac
    case "${FUJISAN_USB_PROFILE}" in
        *mtp*)
            mkdir -p "${GADGET_DIR}/functions/ffs.mtp"
            ln -sf "${GADGET_DIR}/functions/ffs.mtp" "${GADGET_DIR}/configs/c.1/"
            ;;
    esac

    echo "$udc" > "${GADGET_DIR}/UDC" 2>/dev/null || true
    if command -v ip >/dev/null 2>&1 && [ -d /sys/class/net/usb0 ]; then
        ip addr replace "${FUJISAN_USB_IP}" dev usb0 2>/dev/null || true
        ip link set usb0 up 2>/dev/null || true
    fi
    eend 0
}

stop() {
    ebegin "Stopping ${name}"
    if [ -f "${GADGET_DIR}/UDC" ]; then
        echo "" > "${GADGET_DIR}/UDC" 2>/dev/null || true
    fi
    eend 0
}
