# Fujisan OS — SPX4-MF Medium-Format Camera (SPX4 Quad-Core Cortex-A7) Kernel Config
# Target: Pure ARM32 (-marm, 0 Thumb), Linux 6.6.63, Alpine armv7 + Full Imaging BSP
# Budget: zImage <= 5.00 MiB (BANBANINJ staging limit); heavy drivers as =m modules.
# SAFETY: CONFIG_MTD is explicitly disabled so onboard NOR calibration/BKUP is untouchable.

CONFIG_LOCALVERSION="-fujisan-spx4"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KERNEL_GZIP=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_PERF_EVENTS=n
CONFIG_SLUB=y
CONFIG_SHMEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_FHANDLE=y
CONFIG_SECCOMP=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=n

# Strictly keep NOR Flash MTD disabled (protects factory calibration & BKUP)
# CONFIG_MTD is not set

# ARMv7-A Cortex-A7 Pure ARM32 (ZERO Thumb-2, NO LPAE, SCTLR.V=0 + VBAR=0xFFFF0000)
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
# CONFIG_ARCH_MULTI_V6 is not set
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_SMP_FUJI_SPX4=y
CONFIG_VMSPLIT_3G=y
CONFIG_HZ_100=y
CONFIG_AEABI=y
# CONFIG_OABI_COMPAT is not set
# CONFIG_THUMB2_KERNEL is not set
# CONFIG_ARM_LPAE is not set
# CONFIG_CPU_SW_DOMAIN_PAN is not set
# CONFIG_ARM_THUMB is not set
CONFIG_ARM_FUJI_SPX4_VBAR=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_ARM_APPENDED_DTB=n
CONFIG_USE_OF=y
CONFIG_ATAGS=n
CONFIG_AUTO_ZRELADDR=y
CONFIG_ZBOOT_ROM_TEXT=0
CONFIG_ZBOOT_ROM_BSS=0

# Contiguous Memory Allocator (DRM/KMS dumb buffers, CCDIF LV/RAW, Mali-V61, JPEG)
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=8

# Core SPX4 BSP & 4-Layer Imaging PM
CONFIG_ARM_GIC=y
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_FUJISAN_SPX4=y
CONFIG_TIMER_FUJI_SPX4=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_FUJI_SPX4=y
CONFIG_DEVMEM=y
CONFIG_DEVKMEM=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_FUJI_SPX4=y
CONFIG_IIO=y
CONFIG_ADC_FUJI_SPX4=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_FUJI_SPX4=y
CONFIG_SPI=y
CONFIG_SPI_FUJI_SPX4=y

# Display: DRM/KMS + simplefb early-boot handoff + fbcon + Shoulder MIP + VGLIB
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FUJI_SPX4=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=n
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_FB_FUJI_SPX4_DOTLCD=m
CONFIG_FUJI_SPX4_VGLIB=m

# Imaging Pipeline & Video/Still Codecs (Fujisan DAT-Verified Modules)
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_FUJISAN_IMX461=m
CONFIG_VIDEO_FUJISAN_SLVSEC=m
CONFIG_VIDEO_FUJISAN_CCDIF=m
CONFIG_VIDEO_FUJISAN_LENSCOM=m
CONFIG_VIDEO_FUJISAN_MALI_V61=m
CONFIG_VIDEO_FUJI_SPX4_JPEG=m

# Input: Touchscreen + Full SPX4-MF Physical Keys/Stick/Dials + HID/uinput
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_FUJI_SPX4=y
CONFIG_INPUT_FUJI_SPX4=y
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_UHID=m

# Audio: ALSA SoC + Dual I2S + WM8962 SPI4 + 3.5mm Jack Detect (modules)
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_PCM=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_FUJI_SPX4_I2S=m
CONFIG_SND_SOC_FUJI_WM8962_SPI=m
CONFIG_SND_SOC_FUJISAN_SPX4_AUDIO=m

# Storage & Boot Filesystems (Built-in =y for SD2 SquashFS + OverlayFS)
CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_FUJI_SPX4=m
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Networking, Wi-Fi (BCM43438A1 SDIO), Bluetooth (H4 UART)
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=m
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=m
CONFIG_RFKILL=m
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y

# USB 3.0 Synopsys DWC3 (DRD xHCI Host + ConfigFS NCM / UVC / MTP-FunctionFS)
CONFIG_USB_SUPPORT=y
CONFIG_USB=m
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_XHCI_PLATFORM=m
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_FUJI_SPX4=m
CONFIG_USB_HID=m
CONFIG_USB_STORAGE=m
CONFIG_USB_GADGET=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_F_UVC=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_G_CDC=m

# Power, Battery, NVMEM, RTC, Temperature Sensors
CONFIG_NVMEM=y
CONFIG_POWER_SUPPLY=y
CONFIG_POWER_FUJI_SPX4=m
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_FUJI_SPX4=m
CONFIG_HWMON=y
CONFIG_SENSORS_FUJI_SPX4_TEMP=m

# Diagnostics
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_BUG=y
CONFIG_MAGIC_SYSRQ=y
# CONFIG_DEBUG_FS is not set
# CONFIG_FTRACE is not set
# CONFIG_STACKTRACE is not set
