--- a/arch/arm/mm/Kconfig
+++ b/arch/arm/mm/Kconfig
@@ -678,6 +678,17 @@
 	def_bool y
 	depends on ARM_LPAE && ARM_PATCH_PHYS_VIRT && ARCH_KEYSTONE
 
+config ARM_FUJI_SPX4_VBAR
+	bool "Use VBAR=0xFFFF0000 with SCTLR.V=0 (Fujisan SPX4)"
+	depends on CPU_V7 && MMU
+	select ARM_GIC
+	select MULTI_IRQ_HANDLER
+	select GENERIC_ATOMIC64
+	help
+	  Keep SCTLR.V clear and program VBAR=0xFFFF0000 in early_trap_init().
+	  This keeps high exception vectors at 0xFFFF0000 while preserving
+	  SCTLR.V=0 on Cortex-A7 SPX4 hardware and spx4-emulator.
+
 config ARM_THUMB
 	bool "Support Thumb user binaries" if !CPU_THUMBONLY && EXPERT
 	depends on CPU_THUMB_CAPABLE && !CPU_32v4
--- a/arch/arm/mm/proc-v7.S
+++ b/arch/arm/mm/proc-v7.S
@@ -551,6 +551,14 @@
 	orr     r3, r3, #(1 << 10)              @ set SW bit in "clear"
 	bic     r6, r6, #(1 << 10)              @ clear it in "mmuset"
 #endif
+#ifdef CONFIG_ARM_FUJI_SPX4_VBAR
+	orr     r3, r3, #(1 << 13)              @ clear SCTLR.V (use VBAR instead)
+	bic     r6, r6, #(1 << 13)              @ clear CR_V in "mmuset"
+	movw    r0, #0x0000
+	movt    r0, #0xffff
+	mcr     p15, 0, r0, c12, c0, 0          @ program VBAR=0xFFFF0000 before MMU on
+	isb
+#endif
    	mrc	p15, 0, r0, c1, c0, 0		@ read control register
 	bic	r0, r0, r3			@ clear bits them
 	orr	r0, r0, r6			@ set them
